{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "rewrites": [
    { "source": "/retail", "destination": "/index.html" },
    { "source": "/retail/admin", "destination": "/index.html" },
    { "source": "/wholesale", "destination": "/index.html" },
    { "source": "/wholesale/supplier", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
